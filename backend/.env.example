DATABASE_URL=postgresql+psycopg://tr7:tr7@localhost:5432/tr7
SECRET_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key-for-local-dev
SESSION_SECRET=changeme-generate-a-real-session-secret-for-local-dev
CORS_ORIGINS=["http://localhost:3000"]

# Bootstrapped as the one user the first time the app starts against an
# empty database — there is no registration endpoint (personal app).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=changeme

# Set ENVIRONMENT=production for a real deployment — the app refuses to
# start in that mode if any secret above is still its placeholder value
# (see app/core/config.py:assert_production_secrets). Local dev leaves
# this unset (defaults to "development").
# ENVIRONMENT=production

# Only read by docker-compose.prod.yml, to set the Postgres container's
# password and build DATABASE_URL from it — pick a real value for any
# real deployment.
# POSTGRES_PASSWORD=changeme
